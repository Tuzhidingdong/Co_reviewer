{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Co_reviewer/blob/main/schemas/numbering-impact-plan.schema.json",
  "title": "Co_Reviewer Package-wide Numbering Impact Plan",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "created_at_utc",
    "source_graph_sha256",
    "source_documents",
    "number_map",
    "confirmed_ambiguous_mappings",
    "affected_document_roles",
    "definition_updates",
    "mention_updates",
    "change_counts",
    "proposed_graph",
    "numbering_mutation_authorized",
    "authorization_required",
    "impact_plan_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "status": { "const": "awaiting_authorization" },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "source_graph_sha256": { "$ref": "#/$defs/sha256" },
    "source_documents": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/sourceDocument" }
    },
    "number_map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "confirmed_ambiguous_mappings": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "affected_document_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["Reviewers", "Manuscript", "SI"] }
    },
    "definition_updates": {
      "type": "array",
      "items": { "type": "object" }
    },
    "mention_updates": {
      "type": "array",
      "items": { "type": "object" }
    },
    "change_counts": {
      "type": "object",
      "required": ["definitions", "mentions", "documents"],
      "properties": {
        "definitions": { "type": "integer", "minimum": 0 },
        "mentions": { "type": "integer", "minimum": 0 },
        "documents": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "proposed_graph": { "type": "object" },
    "numbering_mutation_authorized": { "const": false },
    "authorization_required": { "const": true },
    "impact_plan_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceDocument": {
      "type": "object",
      "required": ["file", "sha256"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
