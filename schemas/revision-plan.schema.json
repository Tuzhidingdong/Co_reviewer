{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Co_Reviewer Revision Plan",
  "description": "Human-approved, traceable reviewer-comment tasks with one or more linked document targets.",
  "type": "object",
  "required": ["schema_version", "approved", "revision_items"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "approved": { "type": "boolean" },
    "revision_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "reviewer", "comment", "status", "targets"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "reviewer": { "type": "string", "minLength": 1 },
          "comment": { "type": "string", "minLength": 1 },
          "proposed_response": { "type": "string" },
          "approval_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 fingerprint of the exact reviewer comment, proposed response and linked document targets, including source DOCX hashes recorded by preflight-plan when present."
          },
          "preflight_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 fingerprint of the exact target anchors and source DOCX hashes validated by preflight-plan."
          },
          "verification_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 workflow fingerprint of the approved item and exact revised DOCX output hashes confirmed after mechanical and semantic review."
          },
          "verified_output_hashes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "sha256"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              },
              "additionalProperties": false
            }
          },
          "semantic_review_confirmed": { "type": "boolean" },
          "verified_at_utc": { "type": "string", "format": "date-time" },
          "status": { "enum": ["planned", "approved", "applied", "verified", "blocked"] },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["document", "input_file", "output_file", "find", "replace"],
              "properties": {
                "document": { "enum": ["Reviewers", "Manuscript", "SI", "Other"] },
                "input_file": { "type": "string", "minLength": 1 },
                "output_file": { "type": "string", "minLength": 1 },
                "part": { "type": "string", "default": "word/document.xml" },
                "p_idx": { "type": "integer", "minimum": 0 },
                "location": { "type": "string" },
                "find": { "type": "string", "minLength": 1 },
                "replace": { "type": "string" },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$",
                  "description": "SHA-256 of the exact input DOCX bytes recorded by preflight-plan and bound into user approval."
                }
,                "authorized_change": {
                  "type": "object",
                  "required": ["intent"],
                  "properties": {
                    "intent": { "type": "string", "minLength": 1 },
                    "explicitly_authorized_tokens": {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          { "type": "string", "minLength": 1 },
                          {
                            "type": "object",
                            "required": ["text"],
                            "properties": {
                              "kind": { "type": "string" },
                              "text": { "type": "string", "minLength": 1 }
                            },
                            "additionalProperties": false
                          }
                        ]
                      }
                    }
                  },
                  "additionalProperties": false
                },
                "protected_spans": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["start", "end"],
                    "properties": {
                      "start": { "type": "integer", "minimum": 0 },
                      "end": { "type": "integer", "minimum": 0 },
                      "label": { "type": "string" },
                      "authorized": { "type": "boolean", "default": false }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": ["status"],
              "properties": {
                "status": { "enum": ["approved", "applied", "verified"] }
              }
            },
            "then": { "required": ["approval_fingerprint"] }
          },
          {
            "if": {
              "required": ["status"],
              "properties": { "status": { "const": "verified" } }
            },
            "then": {
              "required": [
                "verification_fingerprint",
                "verified_output_hashes",
                "semantic_review_confirmed",
                "verified_at_utc"
              ],
              "properties": { "semantic_review_confirmed": { "const": true } }
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
