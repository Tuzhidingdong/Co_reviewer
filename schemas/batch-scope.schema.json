{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Co_Reviewer Immutable Batch Scope",
  "type": "object",
  "required": [
    "schema_version",
    "batch_id",
    "batch_intent_sha256",
    "revision_round_id",
    "revision_ledger_file",
    "selected_task_ids",
    "batch_task_ids",
    "patch_ids",
    "documents"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "batch_intent_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision_round_id": {
      "type": "string",
      "minLength": 1
    },
    "revision_ledger_file": {
      "type": "string",
      "minLength": 1
    },
    "selected_task_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "batch_task_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "patch_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "documents": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "input_file",
          "input_sha256",
          "output_file"
        ],
        "properties": {
          "input_file": {
            "type": "string",
            "minLength": 1
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "output_file": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
