{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tuzhidingdong/Co_reviewer/blob/main/schemas/committed-release-package.schema.json",
  "title": "Co_Reviewer Immutable Release Package Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "package_id",
    "release_id",
    "source_release_manifest_sha256",
    "artifact_count",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "package_id": { "$ref": "#/$defs/sha256" },
    "release_id": { "type": "string", "minLength": 1 },
    "source_release_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "artifact_count": { "type": "integer", "minimum": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "source_file",
        "sha256",
        "bytes",
        "categories",
        "roles",
        "logical_names"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "source_file": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 },
        "categories": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "roles": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "logical_names": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
