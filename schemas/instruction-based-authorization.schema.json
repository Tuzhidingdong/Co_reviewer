{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "instruction-based-authorization.schema.json",
  "title": "Instruction-based Authorization Receipt",
  "description": "Machine authorization bound to exact source instructions, plan, Coverage, assessment, targets and input DOCX hashes. This is not author_approval.",
  "type": "object",
  "required": [
    "schema_version",
    "authorization_type",
    "status",
    "issued_by",
    "plan_file",
    "plan_sha256",
    "coverage_file",
    "coverage_file_sha256",
    "coverage_sha256",
    "source_instruction",
    "assessment_file",
    "assessment_file_sha256",
    "assessment",
    "input_documents",
    "authorized_targets",
    "authorized_requirement_ids",
    "authorized_at_utc",
    "authorization_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "authorization_type": {"const": "instruction_based_authorization"},
    "status": {"const": "authorized"},
    "issued_by": {"const": "Co_Reviewer automated instruction-scope policy"},
    "plan_file": {"type": "string", "minLength": 1},
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "coverage_file": {"type": "string", "minLength": 1},
    "coverage_file_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "coverage_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_instruction": {
      "type": "object",
      "required": ["file", "sha256"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "assessment_file": {"type": "string", "minLength": 1},
    "assessment_file_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "assessment": {"$ref": "instruction-authorization-assessment.schema.json"},
    "input_documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file", "sha256"],
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "authorized_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["revision_item_id", "target_index", "scope_sha256", "input_file", "input_sha256"],
        "properties": {
          "revision_item_id": {"type": "string", "minLength": 1},
          "target_index": {"type": "integer", "minimum": 0},
          "scope_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "input_file": {"type": "string", "minLength": 1},
          "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "authorized_requirement_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "authorized_at_utc": {"type": "string", "format": "date-time"},
    "authorization_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
