{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Co_Reviewer Immutable Batch Intent",
  "type": "object",
  "required": [
    "schema_version",
    "batch_id",
    "revision_round_id",
    "workflow_ledger_file",
    "workflow_ledger_sha256_at_prepare",
    "created_at_utc",
    "selected_task_ids",
    "all_selected_task_ids",
    "status",
    "documents",
    "policy"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "batch_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"
    },
    "revision_round_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_ledger_file": {
      "type": "string",
      "minLength": 1
    },
    "workflow_ledger_sha256_at_prepare": {
      "$ref": "#/$defs/sha256"
    },
    "batch_creation_protocol_version": {
      "const": "1.0"
    },
    "revision_ledger_file": {
      "type": "string",
      "minLength": 1
    },
    "revision_ledger_sha256_before": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision_ledger_sha256_after": {
      "$ref": "#/$defs/sha256"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "selected_task_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "all_selected_task_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "const": "prepared"
    },
    "documents": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/document"
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "append_only",
        "overwrite_committed_outputs",
        "rollback_deletes_files",
        "publish_mode"
      ],
      "properties": {
        "append_only": {
          "const": true
        },
        "overwrite_committed_outputs": {
          "const": false
        },
        "rollback_deletes_files": {
          "const": false
        },
        "publish_mode": {
          "const": "single_workflow_ledger_active_documents_replace"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "properties": {
        "selected_task_ids": {
          "items": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "batch_creation_protocol_version": {
            "const": "1.0"
          }
        },
        "required": [
          "batch_creation_protocol_version"
        ]
      },
      "then": {
        "required": [
          "revision_ledger_file",
          "revision_ledger_sha256_before",
          "revision_ledger_sha256_after"
        ]
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "document": {
      "type": "object",
      "required": [
        "parent_file",
        "parent_sha256",
        "parent_batch_id",
        "output_file"
      ],
      "properties": {
        "parent_file": {
          "type": "string",
          "minLength": 1
        },
        "parent_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "parent_batch_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_file": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
