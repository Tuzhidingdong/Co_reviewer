{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Co_Reviewer Batch Rollback Receipt",
  "type": "object",
  "required": [
    "schema_version",
    "batch_id",
    "rolled_back_at_utc",
    "workflow_ledger_file",
    "batch_intent_sha256",
    "batch_scope_sha256",
    "restored_active_documents",
    "selected_task_ids",
    "status",
    "retained_batch_files",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "rolled_back_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "workflow_ledger_file": {
      "type": "string",
      "minLength": 1
    },
    "batch_intent_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "batch_scope_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "restored_active_documents": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/pointer"
      }
    },
    "selected_task_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "status": {
      "const": "rolled_back"
    },
    "retained_batch_files": {
      "const": true
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "pointer": {
      "type": "object",
      "required": [
        "file",
        "sha256",
        "batch_id",
        "updated_at_utc"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "batch_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_at_utc": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
