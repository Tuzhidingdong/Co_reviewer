{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Co_Reviewer usage pricing",
  "type": "object",
  "required": [
    "schema_version",
    "currency",
    "rates"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3
    },
    "rates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "accounting_model"
        ],
        "properties": {
          "accounting_model": {
            "const": "disjoint_buckets"
          },
          "input_per_million": {
            "type": "number",
            "minimum": 0
          },
          "cache_read_per_million": {
            "type": "number",
            "minimum": 0
          },
          "cache_write_per_million": {
            "type": "number",
            "minimum": 0
          },
          "output_per_million": {
            "type": "number",
            "minimum": 0
          },
          "reasoning_per_million": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  },
  "additionalProperties": false
}
