{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Co_Reviewer Reference Transaction",
  "description": "One graph-bound, author-approved transaction containing bibliography paragraph insertions, entry updates and all linked in-text citation updates.",
  "type": "object",
  "required": [
    "transaction_id",
    "comment",
    "documents",
    "source_comment_ids"
  ],
  "properties": {
    "transaction_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "comment": {
      "type": "string",
      "minLength": 1
    },
    "proposed_response": {
      "type": "string"
    },
    "source_comment_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "documents": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "input_file",
          "output_file"
        ],
        "properties": {
          "input_file": {
            "type": "string",
            "minLength": 1
          },
          "output_file": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "additions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "operation_id",
          "document",
          "p_idx",
          "anchor_text",
          "position",
          "inserted_text",
          "reference_number",
          "linked_mention_ids",
          "authorized_change",
          "target_identity_mode"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1
          },
          "document": {
            "enum": [
              "Manuscript",
              "SI",
              "Other"
            ]
          },
          "part": {
            "const": "word/document.xml"
          },
          "p_idx": {
            "type": "integer",
            "minimum": 0
          },
          "anchor_text": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "enum": [
              "before",
              "after"
            ]
          },
          "inserted_text": {
            "type": "string",
            "minLength": 1
          },
        "inserted_format_map": {
          "type": "array",
          "minItems": 1,
          "description": "Complete contiguous map from inserted-text character ranges to exact ordinary source Run offsets within anchor_text. Each range inherits direct formatting from the single ordinary Run containing source_offset.",
          "items": {
            "type": "object",
            "required": ["inserted_start", "inserted_end", "source_offset"],
            "properties": {
              "inserted_start": {"type": "integer", "minimum": 0},
              "inserted_end": {"type": "integer", "minimum": 1},
              "source_offset": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          }
        },
          "reference_number": {
            "type": "string",
            "minLength": 1
          },
          "linked_mention_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "source_comment_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "authorized_change": {
            "$ref": "#/$defs/authorizedChange"
          },
          "target_ref": {
            "$ref": "document-identity.schema.json#/$defs/targetRef"
          },
          "target_identity_mode": {
            "enum": [
              "stable_target_ref",
              "legacy_p_idx_explicit"
            ]
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "target_identity_mode": {
                  "const": "stable_target_ref"
                }
              },
              "required": [
                "target_identity_mode"
              ]
            },
            "then": {
              "required": [
                "target_ref"
              ]
            }
          }
        ]
      }
    },
    "entry_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "operation_id",
          "definition_id",
          "document",
          "p_idx",
          "find",
          "replace",
          "authorized_change",
          "target_identity_mode"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1
          },
          "definition_id": {
            "type": "string",
            "minLength": 1
          },
          "document": {
            "enum": [
              "Manuscript",
              "SI",
              "Other"
            ]
          },
          "part": {
            "type": "string",
            "pattern": "^word/"
          },
          "p_idx": {
            "type": "integer",
            "minimum": 0
          },
          "find": {
            "type": "string",
            "minLength": 1
          },
          "replace": {
            "type": "string",
            "minLength": 1
          },
          "new_number": {
            "type": "string",
            "minLength": 1
          },
          "source_comment_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "authorized_change": {
            "$ref": "#/$defs/authorizedChange"
          },
          "target_ref": {
            "$ref": "document-identity.schema.json#/$defs/targetRef"
          },
          "target_identity_mode": {
            "enum": [
              "stable_target_ref",
              "legacy_p_idx_explicit"
            ]
          },
          "replacement_format_map": {
            "$ref": "#/$defs/replacementFormatMap"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "target_identity_mode": {
                  "const": "stable_target_ref"
                }
              },
              "required": [
                "target_identity_mode"
              ]
            },
            "then": {
              "required": [
                "target_ref"
              ]
            }
          }
        ]
      }
    },
    "citation_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "operation_id",
          "mention_id",
          "document",
          "p_idx",
          "find",
          "replace",
          "new_number",
          "authorized_change",
          "target_identity_mode"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "minLength": 1
          },
          "mention_id": {
            "type": "string",
            "minLength": 1
          },
          "document": {
            "enum": [
              "Manuscript",
              "SI",
              "Other"
            ]
          },
          "part": {
            "type": "string",
            "pattern": "^word/"
          },
          "p_idx": {
            "type": "integer",
            "minimum": 0
          },
          "find": {
            "type": "string",
            "minLength": 1
          },
          "replace": {
            "type": "string",
            "minLength": 1
          },
          "new_number": {
            "type": "string",
            "minLength": 1
          },
          "source_comment_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "authorized_change": {
            "$ref": "#/$defs/authorizedChange"
          },
          "target_ref": {
            "$ref": "document-identity.schema.json#/$defs/targetRef"
          },
          "target_identity_mode": {
            "enum": [
              "stable_target_ref",
              "legacy_p_idx_explicit"
            ]
          },
          "replacement_format_map": {
            "$ref": "#/$defs/replacementFormatMap"
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "target_identity_mode": {
                  "const": "stable_target_ref"
                }
              },
              "required": [
                "target_identity_mode"
              ]
            },
            "then": {
              "required": [
                "target_ref"
              ]
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "authorizedChange": {
      "type": "object",
      "required": [
        "intent"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "explicitly_authorized_tokens": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "replacement"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "replacement": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "explicitly_authorized_insertions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "description": "Every protected token introduced by an operation must be listed exactly once with its exact token kind and text. Reference Transaction bibliography labels may use the graph-supported [n], n. or n) forms; authorizing the label does not implicitly authorize any other numeric token in the inserted entry."
        },
        "explicitly_authorized_deletions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "explicitly_authorized_spans": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "replacementFormatMap": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "replacement_start",
          "replacement_end",
          "source_offset"
        ],
        "properties": {
          "replacement_start": {
            "type": "integer",
            "minimum": 0
          },
          "replacement_end": {
            "type": "integer",
            "minimum": 1
          },
          "source_offset": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
