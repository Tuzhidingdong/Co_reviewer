{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/co-reviewer/instruction-coverage.schema.json",
  "title": "Co_Reviewer Original Instruction Coverage Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "source_instruction",
    "requirements",
    "coverage_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source_instruction": {
      "type": "object",
      "required": [
        "file",
        "sha256"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "coverage_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "required": [
        "requirement_id",
        "source_locator",
        "instruction_excerpt",
        "status"
      ],
      "properties": {
        "requirement_id": {
          "type": "string",
          "minLength": 1
        },
        "source_locator": {
          "type": "string",
          "minLength": 1
        },
        "instruction_excerpt": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "planned",
            "no_change",
            "manual_completed",
            "not_applicable",
            "blocked",
            "deferred"
          ]
        },
        "revision_item_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "evidence_file": {
          "type": "string",
          "minLength": 1
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "revision_targets": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "revision_item_id",
              "target_index"
            ],
            "properties": {
              "revision_item_id": {
                "type": "string",
                "minLength": 1
              },
              "target_index": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "planned"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "revision_targets"
            ],
            "properties": {
              "revision_targets": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "no_change",
                  "not_applicable"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "evidence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "blocked",
                  "deferred"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "manual_completed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "evidence_file",
              "evidence_sha256"
            ]
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
