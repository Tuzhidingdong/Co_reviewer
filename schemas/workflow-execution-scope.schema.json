{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Co_Reviewer Workflow Execution Scope",
  "description": "Author-reviewed exact PatchOperations and ResponseUnit dispositions attached to a validated pending Workflow Ledger. Does not authorize edits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision_round_id",
    "workflow_ledger_sha256",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "revision_round_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_ledger_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "identity_mode": {
      "enum": [
        "stable_target_ref",
        "legacy_p_idx_explicit"
      ],
      "description": "Omit or use stable_target_ref for registered identities. legacy_p_idx_explicit is migration-only and is never represented as stable identity."
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "patch_operations"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "patch_id": {
            "type": "string",
            "minLength": 1
          },
          "proposed_response": {
            "type": "string"
          },
          "supersedes_patch_id": {
            "type": "string",
            "minLength": 1
          },
          "patch_operations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "operation_id",
                "document",
                "part",
                "p_idx",
                "find",
                "replace",
                "evidence_ids"
              ],
              "properties": {
                "operation_id": {
                  "type": "string",
                  "minLength": 1
                },
                "document": {
                  "enum": [
                    "Manuscript",
                    "SI"
                  ]
                },
                "part": {
                  "type": "string",
                  "pattern": "^word/"
                },
                "p_idx": {
                  "type": "integer",
                  "minimum": 0
                },
                "find": {
                  "type": "string",
                  "minLength": 1
                },
                "replace": {
                  "type": "string"
                },
                "location": {
                  "type": "string"
                },
                "evidence_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "source_comment_ids": {
                  "type": "array",
                  "minItems": 0,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "location_phrase": {
                  "type": "string",
                  "maxLength": 255
                },
                "target_ref": {
                  "$ref": "document-identity.schema.json#/$defs/targetRef"
                },
                "author_decision_ref": {
                  "$ref": "revision-ledger.schema.json#/$defs/authorDecisionRef"
                },
                "two_pass": {
                  "type": "boolean",
                  "description": "Explicitly authorizes text insertion followed by FormatChange on the newly inserted substring in the same operation."
                },
                "format_authorization": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["intent", "semantic_profile_sha256", "format_zone"],
                  "properties": {
                    "intent": {"type": "string", "minLength": 1},
                    "semantic_profile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                    "format_zone": {"enum": ["body", "references"]}
                  }
                },
                "format_operations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["find", "source_occurrence_id"],
                    "properties": {
                      "find": {"type": "string", "minLength": 1},
                      "source_occurrence_id": {"type": "string", "minLength": 1},
                      "properties": {"type": "object"},
                      "scope_find": {"type": "string", "minLength": 1},
                      "scope_offset": {"type": "integer", "minimum": 0}
                    },
                    "allOf": [
                      {
                        "if": {"required": ["scope_find"]},
                        "then": {"required": ["scope_offset"]}
                      },
                      {
                        "if": {"required": ["scope_offset"]},
                        "then": {"required": ["scope_find"]}
                      }
                    ]
                  }
                },
                "replacement_format_map": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["replacement_start", "replacement_end", "source_offset"],
                    "properties": {
                      "replacement_start": {"type": "integer", "minimum": 0},
                      "replacement_end": {"type": "integer", "minimum": 1},
                      "source_offset": {"type": "integer", "minimum": 0}
                    }
                  }
                }
              },
              "allOf": [
                {
                  "if": {"properties": {"two_pass": {"const": true}}, "required": ["two_pass"]},
                  "then": {
                    "required": ["format_authorization", "format_operations"],
                    "properties": {
                      "format_operations": {
                        "minItems": 1,
                        "items": {
                          "required": ["scope_find", "scope_offset"]
                        }
                      }
                    }
                  }
                }
              ]
            }
          },
          "response_unit_specs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "comment_id",
                "disposition",
                "location_requirement"
              ],
              "properties": {
                "comment_id": {
                  "type": [
                    "string",
                    "integer"
                  ]
                },
                "disposition": {
                  "enum": [
                    "revised",
                    "reply_only",
                    "no_change",
                    "clarification_needed"
                  ]
                },
                "location_requirement": {
                  "enum": [
                    "required",
                    "existing_anchor_required",
                    "not_required",
                    "manual_required"
                  ]
                },
                "resolution_reason": {
                  "type": "string"
                },
                "anchor_evidence_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "disposition": {
                        "const": "no_change"
                      }
                    },
                    "required": [
                      "disposition"
                    ]
                  },
                  "then": {
                    "required": [
                      "anchor_evidence_id"
                    ],
                    "properties": {
                      "location_requirement": {
                        "enum": [
                          "existing_anchor_required",
                          "manual_required"
                        ]
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "disposition": {
                        "const": "reply_only"
                      }
                    },
                    "required": [
                      "disposition"
                    ]
                  },
                  "then": {
                    "properties": {
                      "location_requirement": {
                        "const": "not_required"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "disposition": {
                        "const": "clarification_needed"
                      }
                    },
                    "required": [
                      "disposition"
                    ]
                  },
                  "then": {
                    "properties": {
                      "location_requirement": {
                        "not": {
                          "const": "not_required"
                        }
                      }
                    }
                  }
                }
              ]
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "description": "For a document-changing task in recheck_required, append fresh evidence from current active DOCX versions. Evidence IDs must be new. Executable target evidence must be confirmed and match the current inventory paragraph/part.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_id",
                "document",
                "part",
                "p_idx",
                "source_excerpt",
                "evidence_type",
                "match_status"
              ],
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "minLength": 1
                },
                "document": {
                  "enum": [
                    "Reviewers",
                    "Manuscript",
                    "SI"
                  ]
                },
                "part": {
                  "type": "string",
                  "minLength": 1
                },
                "p_idx": {
                  "type": "integer",
                  "minimum": 0
                },
                "para_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "source_comment_id": {
                  "type": [
                    "string",
                    "integer",
                    "null"
                  ]
                },
                "source_excerpt": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_type": {
                  "enum": [
                    "reviewer_comment",
                    "native_anchor",
                    "paragraph",
                    "caption",
                    "reference",
                    "table",
                    "figure",
                    "audit_finding"
                  ]
                },
                "match_status": {
                  "enum": [
                    "confirmed",
                    "candidate",
                    "ambiguous",
                    "unresolved",
                    "not_applicable"
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "evidence_type": {
                        "const": "reviewer_comment"
                      }
                    },
                    "required": [
                      "evidence_type"
                    ]
                  },
                  "then": {
                    "required": [
                      "source_comment_id"
                    ],
                    "properties": {
                      "part": {
                        "const": "word/comments.xml"
                      }
                    }
                  }
                }
              ]
            }
          },
          "targets": {
            "type": "array",
            "description": "For a recheck_required document task, the complete refreshed target set from the current active inventory. Each target must reference fresh evidence in the same task scope.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "document",
                "part",
                "p_idx",
                "action",
                "evidence_ids"
              ],
              "properties": {
                "document": {
                  "enum": [
                    "Reviewers",
                    "Manuscript",
                    "SI"
                  ]
                },
                "part": {
                  "type": "string",
                  "minLength": 1
                },
                "p_idx": {
                  "type": "integer",
                  "minimum": 0
                },
                "para_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "action": {
                  "enum": [
                    "replace",
                    "add",
                    "remove",
                    "renumber",
                    "reference_update",
                    "keep",
                    "inspect_only",
                    "reply_only"
                  ]
                },
                "evidence_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "target_refs": {
            "type": "array",
            "description": "Refresh persistent TargetRefs when a rechecked task's stable object identity changes.",
            "items": {
              "$ref": "document-identity.schema.json#/$defs/targetRef"
            }
          },
          "author_decision_ref": {
            "$ref": "revision-ledger.schema.json#/$defs/authorDecisionRef",
            "description": "Author authorization for package-wide numbering; preparation copies it into every executable operation."
          }
        },
        "description": "For a task in recheck_required with document-mutating targets, include both refreshed evidence and refreshed targets; old paragraph coordinates and excerpts must not be reused.",
        "allOf": [
          {
            "if": {
              "required": [
                "author_decision_ref"
              ]
            },
            "then": {
              "properties": {
                "patch_operations": {
                  "items": {
                    "properties": {
                      "author_decision_ref": {
                        "$ref": "revision-ledger.schema.json#/$defs/authorDecisionRef"
                      }
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "patch_operations": {
                  "items": {
                    "required": [
                      "source_comment_ids"
                    ],
                    "properties": {
                      "source_comment_ids": {
                        "type": "array",
                        "minItems": 1
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "reviewer_map": {
      "type": "object",
      "description": "Optional task-level reviewer overrides. Native comment authors are used by default; unknown author labels fall back to Reviewer.",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "default": {
                "type": "string",
                "minLength": 1
              },
              "patch_label": {
                "type": "string",
                "minLength": 1
              },
              "comment_ids": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
