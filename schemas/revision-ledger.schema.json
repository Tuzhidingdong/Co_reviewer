{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Co_Reviewer v0.5.1 Revision Ledger",
  "description": "Typed Patch operations, document revision records, append-only execution events and reviewer ResponseUnits. This ledger is adapted to the legacy DOCX writer only after exact patch authoring and preflight.",
  "type": "object",
  "required": [
    "schema_version",
    "revision_round_id",
    "documents",
    "patches",
    "response_units",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "0.5.1"
    },
    "revision_round_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_ledger_fingerprint": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/revisionDocument"
      }
    },
    "patches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/patch"
      }
    },
    "response_units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/responseUnit"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/revisionEvent"
      }
    },
    "workflow_task_fingerprints": {
      "type": "object",
      "description": "Scope fingerprints for every Workflow Ledger task in this review round. Lifecycle state/event changes do not alter scope; evidence, action, dependency or target changes do.",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  },
  "$defs": {
    "patchOperation": {
      "type": "object",
      "required": [
        "operation_id",
        "document",
        "input_file",
        "output_file",
        "part",
        "find",
        "replace",
        "evidence_ids",
        "source_comment_ids"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "document": {
          "type": "string",
          "minLength": 1
        },
        "input_file": {
          "type": "string",
          "minLength": 1
        },
        "output_file": {
          "type": "string",
          "minLength": 1
        },
        "part": {
          "type": "string",
          "pattern": "^word/"
        },
        "find": {
          "type": "string",
          "minLength": 1
        },
        "replace": {
          "type": "string"
        },
        "p_idx": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "location": {
          "type": "string"
        },
        "source_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "source_comment_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "location_phrase": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 255
        },
        "target_identity_mode": {
          "enum": [
            "stable_target_ref",
            "legacy_p_idx_explicit"
          ],
          "description": "Explicitly labels stable identity or migration-only paragraph-index compatibility."
        },
        "target_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "document-identity.schema.json#/$defs/targetRef"
            }
          ]
        },
        "authorized_change": {
          "type": "object",
          "description": "Proposed change scope. It becomes authorized only when the human approval fingerprint seals this exact target.",
          "required": [
            "intent"
          ],
          "properties": {
            "intent": {
              "type": "string",
              "minLength": 1
            },
            "explicitly_authorized_tokens": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "text",
                  "replacement"
                ],
                "properties": {
                  "kind": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "replacement": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "explicitly_authorized_insertions": {
              "type": "array",
              "description": "Exact individual protected-token values approved for insertion; every inserted token must match one entry.",
              "items": {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "kind": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "explicitly_authorized_deletions": {
              "type": "array",
              "description": "Exact individual protected-token values approved for deletion; every deleted token must match one entry.",
              "items": {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "kind": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "explicitly_authorized_spans": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "start",
                  "end"
                ],
                "properties": {
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "protected_spans": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 1
              },
              "label": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "replacement_format_map": {
          "type": "array",
          "minItems": 1,
          "description": "Complete character-range map for carrying formatting from exact source Run offsets into the replacement text.",
          "items": {
            "type": "object",
            "required": [
              "replacement_start",
              "replacement_end",
              "source_offset"
            ],
            "properties": {
              "replacement_start": {
                "type": "integer",
                "minimum": 0
              },
              "replacement_end": {
                "type": "integer",
                "minimum": 1
              },
              "source_offset": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "format_authorization": {
          "type": "object",
          "required": [
            "intent"
          ],
          "properties": {
            "intent": {
              "type": "string",
              "minLength": 1
            },
            "semantic_profile_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "format_zone": {
              "enum": [
                "body",
                "references"
              ]
            }
          },
          "additionalProperties": false
        },
        "two_pass": {
          "type": "boolean"
        },
        "format_operations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "find",
              "properties"
            ],
            "properties": {
              "find": {
                "type": "string",
                "minLength": 1
              },
              "source_occurrence_id": {
                "type": "string",
                "minLength": 1
              },
              "scope_find": {
                "type": "string",
                "minLength": 1
              },
              "scope_offset": {
                "type": "integer",
                "minimum": 0
              },
              "properties": {
                "type": "object",
                "minProperties": 1,
                "properties": {
                  "b": {
                    "type": "boolean"
                  },
                  "bCs": {
                    "type": "boolean"
                  },
                  "i": {
                    "type": "boolean"
                  },
                  "iCs": {
                    "type": "boolean"
                  },
                  "caps": {
                    "type": "boolean"
                  },
                  "smallCaps": {
                    "type": "boolean"
                  },
                  "strike": {
                    "type": "boolean"
                  },
                  "dstrike": {
                    "type": "boolean"
                  },
                  "outline": {
                    "type": "boolean"
                  },
                  "shadow": {
                    "type": "boolean"
                  },
                  "emboss": {
                    "type": "boolean"
                  },
                  "imprint": {
                    "type": "boolean"
                  },
                  "sz": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "szCs": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "position": {
                    "type": "integer"
                  },
                  "spacing": {
                    "type": "integer"
                  },
                  "rStyle": {
                    "type": "string",
                    "minLength": 1
                  },
                  "color": {
                    "type": "string",
                    "pattern": "^(?:[0-9A-Fa-f]{6}|auto)$"
                  },
                  "vertAlign": {
                    "enum": [
                      "baseline",
                      "superscript",
                      "subscript"
                    ]
                  },
                  "u": {
                    "enum": [
                      "single",
                      "double",
                      "dotted",
                      "dash",
                      "wave",
                      "none"
                    ]
                  },
                  "highlight": {
                    "type": "string"
                  },
                  "rFonts": {
                    "type": "object",
                    "minProperties": 1,
                    "properties": {
                      "ascii": {
                        "type": "string",
                        "minLength": 1
                      },
                      "hAnsi": {
                        "type": "string",
                        "minLength": 1
                      },
                      "eastAsia": {
                        "type": "string",
                        "minLength": 1
                      },
                      "cs": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "action": {
          "enum": [
            "replace",
            "insert_paragraph"
          ],
          "default": "replace"
        },
        "anchor_text": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "enum": [
            "before",
            "after"
          ]
        },
        "inserted_text": {
          "type": "string",
          "minLength": 1
        },
        "inserted_format_map": {
          "type": "array",
          "minItems": 1,
          "description": "Complete contiguous map from inserted-text character ranges to exact ordinary source Run offsets within anchor_text. Each range inherits direct formatting from the single ordinary Run containing source_offset.",
          "items": {
            "type": "object",
            "required": ["inserted_start", "inserted_end", "source_offset"],
            "properties": {
              "inserted_start": {"type": "integer", "minimum": 0},
              "inserted_end": {"type": "integer", "minimum": 1},
              "source_offset": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "two_pass"
            ],
            "properties": {
              "two_pass": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "format_authorization",
              "format_operations"
            ],
            "properties": {
              "format_authorization": {
                "required": [
                  "intent",
                  "semantic_profile_sha256",
                  "format_zone"
                ]
              },
              "format_operations": {
                "minItems": 1,
                "items": {
                  "required": [
                    "find",
                    "properties",
                    "source_occurrence_id",
                    "scope_find",
                    "scope_offset"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "target_ref"
            ],
            "properties": {
              "target_ref": {
                "type": "object"
              }
            }
          },
          "then": {
            "required": [
              "target_identity_mode"
            ],
            "properties": {
              "target_identity_mode": {
                "const": "stable_target_ref"
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "not": {
                  "required": [
                    "target_ref"
                  ]
                }
              },
              {
                "properties": {
                  "target_ref": {
                    "type": "null"
                  }
                }
              }
            ]
          },
          "then": {
            "required": [
              "target_identity_mode",
              "p_idx"
            ],
            "properties": {
              "target_identity_mode": {
                "const": "legacy_p_idx_explicit"
              },
              "p_idx": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "insert_paragraph"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "required": [
              "anchor_text",
              "position",
              "inserted_text"
            ],
            "properties": {
              "part": {
                "const": "word/document.xml"
              }
            }
          }
        },
        {
          "if": {
            "required": ["inserted_format_map"]
          },
          "then": {
            "required": ["action"],
            "properties": {
              "action": {"const": "insert_paragraph"}
            }
          }
        }
      ]
    },
    "patch": {
      "type": "object",
      "required": [
        "patch_id",
        "task_id",
        "reviewer",
        "comment",
        "proposed_response",
        "operations",
        "status",
        "apply_report_ids",
        "verified_output_hashes"
      ],
      "properties": {
        "patch_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "comment": {
          "type": "string",
          "minLength": 1
        },
        "proposed_response": {
          "type": "string"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/patchOperation"
          }
        },
        "status": {
          "enum": [
            "planned",
            "preflighted",
            "approved",
            "applied",
            "verified",
            "superseded",
            "blocked",
            "abandoned"
          ]
        },
        "supersedes_patch_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "approval_fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "apply_report_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verification_report_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "verified_output_hashes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "preflight_fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "preflight_report_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "applied_revision_ids": {
          "type": "array",
          "description": "Exact output revision IDs bound to an apply report and input/output DOCX SHA-256 lineage for deterministic Clean compilation.",
          "items": {
            "type": "object",
            "required": [
              "input_file",
              "input_sha256",
              "output_file",
              "output_sha256",
              "revision_ids"
            ],
            "properties": {
              "input_file": {
                "type": "string",
                "minLength": 1
              },
              "input_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "output_file": {
                "type": "string",
                "minLength": 1
              },
              "output_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "revision_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "preflighted",
                  "approved",
                  "applied",
                  "verified"
                ]
              }
            }
          },
          "then": {
            "required": [
              "preflight_fingerprint",
              "preflight_report_id"
            ]
          }
        },
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "approved",
                  "applied",
                  "verified"
                ]
              }
            }
          },
          "then": {
            "required": [
              "approval_fingerprint"
            ]
          }
        },
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "verified"
              }
            }
          },
          "then": {
            "required": [
              "verification_report_id"
            ],
            "properties": {
              "verified_output_hashes": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "superseded"
              }
            }
          },
          "then": {
            "required": [
              "supersedes_patch_id"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "revisionDocument": {
      "type": "object",
      "required": [
        "document_id",
        "revision_id",
        "role",
        "input_file",
        "output_file"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "revision_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "input_file": {
          "type": "string",
          "minLength": 1
        },
        "output_file": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "output_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "working_clean_file": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "working_clean_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "working_view_fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "responseLocation": {
      "type": "object",
      "required": [
        "document",
        "output_file",
        "pdf_file",
        "page",
        "line_start",
        "line_end",
        "pdf_sha256",
        "location_map_id",
        "mapping_fingerprint",
        "output_sha256",
        "locator_id",
        "source_clean_sha256",
        "mapping_method",
        "locator_text"
      ],
      "properties": {
        "document": {
          "type": "string",
          "minLength": 1
        },
        "output_file": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "line_start": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "line_end": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "pdf_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "location_map_id": {
          "type": "string",
          "minLength": 1
        },
        "mapping_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "output_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "locator_id": {
          "type": "string",
          "minLength": 1
        },
        "source_clean_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mapping_method": {
          "enum": [
            "word_com",
            "manual"
          ]
        },
        "locator_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "pdf_file": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\.pdf$"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "mapping_method"
            ],
            "properties": {
              "mapping_method": {
                "const": "word_com"
              }
            }
          },
          "then": {
            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "line_start": {
                "type": "integer",
                "minimum": 1
              },
              "line_end": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "mapping_method"
            ],
            "properties": {
              "mapping_method": {
                "const": "manual"
              }
            }
          },
          "then": {
            "required": [
              "locator_text"
            ],
            "properties": {
              "locator_text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "line_start",
              "line_end"
            ],
            "properties": {
              "line_start": {
                "type": "integer"
              },
              "line_end": {
                "type": "integer"
              }
            }
          },
          "then": {
            "properties": {
              "line_end": {
                "minimum": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
