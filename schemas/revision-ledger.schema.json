{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Co_Reviewer v0.5.1 Revision Ledger",
  "description": "Typed Patch operations, document revision records, append-only execution events and reviewer ResponseUnits. This ledger is adapted to the legacy DOCX writer only after exact patch authoring and preflight.",
  "type": "object",
  "required": [
    "schema_version",
    "revision_round_id",
    "documents",
    "patches",
    "response_units",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "0.5.1"
    },
    "revision_round_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_ledger_fingerprint": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/revisionDocument"
      }
    },
    "patches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/patch"
      }
    },
    "response_units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/responseUnit"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/revisionEvent"
      }
    }
  },
  "$defs": {
    "patchOperation": {
      "type": "object",
      "required": [
        "operation_id",
        "document",
        "input_file",
        "output_file",
        "part",
        "find",
        "replace",
        "evidence_ids"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "document": {
          "type": "string",
          "minLength": 1
        },
        "input_file": {
          "type": "string",
          "minLength": 1
        },
        "output_file": {
          "type": "string",
          "minLength": 1
        },
        "part": {
          "type": "string",
          "pattern": "^word/"
        },
        "find": {
          "type": "string",
          "minLength": 1
        },
        "replace": {
          "type": "string"
        },
        "p_idx": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "location": {
          "type": "string"
        },
        "source_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "target_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "document-identity.schema.json#/$defs/targetRef"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "patch": {
      "type": "object",
      "required": [
        "patch_id",
        "task_id",
        "reviewer",
        "comment",
        "proposed_response",
        "operations",
        "status",
        "apply_report_ids",
        "verified_output_hashes"
      ],
      "properties": {
        "patch_id": {
          "type": "string",
          "minLength": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "comment": {
          "type": "string",
          "minLength": 1
        },
        "proposed_response": {
          "type": "string"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/patchOperation"
          }
        },
        "status": {
          "enum": [
            "planned",
            "preflighted",
            "approved",
            "applied",
            "verified",
            "superseded",
            "blocked"
          ]
        },
        "supersedes_patch_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "approval_fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "apply_report_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verification_report_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "verified_output_hashes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "preflight_fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "preflight_report_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "preflighted",
                  "approved",
                  "applied",
                  "verified"
                ]
              }
            }
          },
          "then": {
            "required": [
              "preflight_fingerprint",
              "preflight_report_id"
            ]
          }
        },
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "approved",
                  "applied",
                  "verified"
                ]
              }
            }
          },
          "then": {
            "required": [
              "approval_fingerprint"
            ]
          }
        },
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "verified"
              }
            }
          },
          "then": {
            "required": [
              "verification_report_id"
            ],
            "properties": {
              "verified_output_hashes": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "superseded"
              }
            }
          },
          "then": {
            "required": [
              "supersedes_patch_id"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "revisionDocument": {
      "type": "object",
      "required": [
        "document_id",
        "revision_id",
        "role",
        "input_file",
        "output_file"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "revision_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "input_file": {
          "type": "string",
          "minLength": 1
        },
        "output_file": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "output_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "responseLocation": {
      "type": "object",
      "required": [
        "document",
        "output_file",
        "pdf_file",
        "page",
        "line_start",
        "line_end",
        "pdf_sha256",
        "location_map_id",
        "mapping_fingerprint"
      ],
      "properties": {
        "document": {
          "type": "string",
          "minLength": 1
        },
        "output_file": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "pdf_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "location_map_id": {
          "type": "string",
          "minLength": 1
        },
        "mapping_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "pdf_file": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\.pdf$"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "line_start",
              "line_end"
            ],
            "properties": {
              "line_start": {
                "type": "integer"
              },
              "line_end": {
                "type": "integer"
              }
            }
          },
          "then": {
            "properties": {
              "line_end": {
                "minimum": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "responseUnit": {
      "type": "object",
      "required": [
        "response_unit_id",
        "reviewer",
        "comment_id",
        "comment_text",
        "response_text",
        "linked_task_ids",
        "linked_patch_ids",
        "linked_targets",
        "status",
        "semantic_review_confirmed",
        "final_locations"
      ],
      "properties": {
        "response_unit_id": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "comment_id": {
          "type": "string",
          "minLength": 1
        },
        "comment_text": {
          "type": "string",
          "minLength": 1
        },
        "response_text": {
          "type": "string"
        },
        "linked_task_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "linked_patch_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "linked_targets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "document",
              "location",
              "output_file"
            ],
            "properties": {
              "document": {
                "type": "string"
              },
              "location": {
                "type": "string"
              },
              "output_file": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "status": {
          "enum": [
            "draft",
            "blocked",
            "verified",
            "location_mapped",
            "completed"
          ]
        },
        "semantic_review_confirmed": {
          "type": "boolean"
        },
        "verification_report_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "location_map_fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "final_locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/responseLocation"
          }
        },
        "completed_at_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "location_map_file": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "location_map_file_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "verified",
                  "location_mapped",
                  "completed"
                ]
              }
            }
          },
          "then": {
            "required": [
              "verification_report_id",
              "location_map_file",
              "location_map_file_sha256"
            ],
            "properties": {
              "semantic_review_confirmed": {
                "const": true
              },
              "response_text": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "location_mapped",
                  "completed"
                ]
              }
            }
          },
          "then": {
            "required": [
              "location_map_fingerprint",
              "location_map_file",
              "location_map_file_sha256"
            ],
            "properties": {
              "semantic_review_confirmed": {
                "const": true
              },
              "final_locations": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "required": [
              "completed_at_utc"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "revisionEvent": {
      "type": "object",
      "required": [
        "event_id",
        "subject_id",
        "subject_type",
        "event_type",
        "timestamp_utc",
        "actor",
        "details"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_type": {
          "enum": [
            "patch",
            "response_unit"
          ]
        },
        "event_type": {
          "type": "string",
          "minLength": 1
        },
        "timestamp_utc": {
          "type": "string",
          "format": "date-time"
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
