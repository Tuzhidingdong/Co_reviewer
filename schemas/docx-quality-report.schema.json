{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Co_Reviewer DOCX quality report",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "docx",
    "checks",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "PASS",
        "PASS_WITH_WARNINGS",
        "FAIL"
      ]
    },
    "docx": {
      "type": "object"
    },
    "pdf": {
      "type": [
        "object",
        "null"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "severity",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "WARN",
              "FAIL"
            ]
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "summary": {
            "type": "string"
          },
          "evidence": {}
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "passed",
        "warnings",
        "failures"
      ],
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "failures": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "additionalProperties": true
}
